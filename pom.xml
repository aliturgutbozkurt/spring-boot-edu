<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root aggregator. It only lists modules; all build configuration lives in build-parent/pom.xml.

  ./mvnw verify               → build-parent + every lesson/ and solution/ module (always green)
  ./mvnw -Pexercises test     → additionally the exercise/ modules (red until the student solves them)

  Module entries are added by scripts/new-module.sh — keep the markers below intact.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.springbootedu</groupId>
    <artifactId>spring-boot-edu</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Spring Boot Edu</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>build-parent</module>
        <!-- course-modules:begin -->
        <module>modules/00-setup-modern-java/lesson</module>
        <module>modules/00-setup-modern-java/solution</module>
        <module>modules/01-core-container/lesson</module>
        <module>modules/01-core-container/solution</module>
        <module>modules/02-configuration/lesson</module>
        <module>modules/02-configuration/solution</module>
        <module>modules/02-configuration/starter/bookstore-greeting-autoconfigure</module>
        <module>modules/02-configuration/starter/bookstore-greeting-spring-boot-starter</module>
        <module>modules/03-web-mvc/lesson</module>
        <module>modules/03-web-mvc/solution</module>
        <module>modules/04-http-clients-resilience/lesson</module>
        <module>modules/04-http-clients-resilience/solution</module>
        <module>modules/05-data-jdbc-postgres/lesson</module>
        <module>modules/05-data-jdbc-postgres/solution</module>
        <module>modules/06-data-jpa-postgres/lesson</module>
        <module>modules/06-data-jpa-postgres/solution</module>
        <module>modules/07-data-mongodb/lesson</module>
        <module>modules/07-data-mongodb/solution</module>
        <module>modules/08-redis-caching/lesson</module>
        <module>modules/08-redis-caching/solution</module>
        <module>modules/09-hazelcast/lesson</module>
        <module>modules/09-hazelcast/solution</module>
        <!-- course-modules:end -->
    </modules>

    <profiles>
        <profile>
            <id>exercises</id>
            <modules>
                <!-- exercise-modules:begin -->
                <module>modules/00-setup-modern-java/exercise</module>
                <module>modules/01-core-container/exercise</module>
                <module>modules/02-configuration/exercise</module>
                <module>modules/03-web-mvc/exercise</module>
                <module>modules/04-http-clients-resilience/exercise</module>
                <module>modules/05-data-jdbc-postgres/exercise</module>
                <module>modules/06-data-jpa-postgres/exercise</module>
                <module>modules/07-data-mongodb/exercise</module>
                <module>modules/08-redis-caching/exercise</module>
                <module>modules/09-hazelcast/exercise</module>
                <!-- exercise-modules:end -->
            </modules>
        </profile>
    </profiles>
</project>
